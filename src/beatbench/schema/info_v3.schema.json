{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "songName", "songAuthorName", "beatsPerMinute",
               "songFilename", "coverImageFilename", "difficultyBeatmapSets"],
  "properties": {
    "version": {"type": "string"},
    "songName": {"type": "string", "minLength": 1},
    "songSubName": {"type": "string"},
    "songAuthorName": {"type": "string"},
    "levelAuthorName": {"type": "string"},
    "beatsPerMinute": {"type": "number", "exclusiveMinimum": 0},
    "shuffle": {"type": "number"},
    "shufflePeriod": {"type": "number"},
    "previewStartTime": {"type": "number"},
    "songFilename": {"type": "string", "minLength": 1},
    "coverImageFilename": {"type": "string", "minLength": 1},
    "environmentName": {"type": "string"},
    "allDirectionsEnvironmentName": {"type": "string"},
    "environmentNames": {"type": "array", "items": {"type": "string"}},
    "colorSchemes": {"type": "array"},
    "difficultyBeatmapSets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["_beatmapCharacteristicName", "_difficultyBeatmaps"],
        "properties": {
          "_beatmapCharacteristicName": {"type": "string"},
          "_difficultyBeatmaps": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["_difficulty", "_beatmapFilename"],
              "properties": {
                "_difficulty": {"type": "string"},
                "_difficultyRank": {"type": "integer"},
                "_beatmapFilename": {"type": "string", "minLength": 1},
                "_noteJumpMovementSpeed": {"type": "number"},
                "_noteJumpStartBeatOffset": {"type": "number"}
              }
            }
          }
        }
      }
    }
  }
}
